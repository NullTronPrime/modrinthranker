, "gallery": [{"url": "https://cdn.modrinth.com/data/7V67Qgbs/images/4e8aa6da5f4ebdc83e2cf0990d831d0108b7955c_350.webp", "raw_url": "https://cdn.modrinth.com/data/7V67Qgbs/images/4e8aa6da5f4ebdc83e2cf0990d831d0108b7955c.png", "featured": false, "title": "3x3 Hotswap card", "description": "hotswap gamemode card showing tasks expiring", "created": "2025-10-04T13:53:51.233415Z", "ordering": 0}, {"url": "https://cdn.modrinth.com/data/7V67Qgbs/images/97f35a223da8cfc02cd6274a57eb3a9fd91e83a2_350.webp", "raw_url": "https://cdn.modrinth.com/data/7V67Qgbs/images/97f35a223da8cfc02cd6274a57eb3a9fd91e83a2.png", "featured": true, "title": "Bingo card", "description": "image showing regular bingo card", "created": "2025-10-04T13:53:07.873277Z", "ordering": 0}], "color": 7585345, "thread_id": "h6JSQugC", "monetization_status": "monetized"}, {"client_side": "required", "server_side": "unsupported", "game_versions": ["1.21.1", "1.21.10", "1.21.11", "26.1.2", "26.2", "26.3"], "environment": ["client_only"], "id": "QhX1nx34", "slug": "oneclient-modpack", "project_type": "modpack", "team": "gOL79K4v", "organization": "ej1CryYY", "title": "OneClient", "description": "All in one modpack for OneClient, the client for everyone. Boost FPS / performance, world hosting, get all your QoL features, in one place.", "body": "# OneClient\n\nOneClient ships the most bleeding-edge mods, packaged with the best visuals out of any client, powered by [OneConfig](https://modrinth.com/mod/oneconfig).\n\n## Performance\n\nIn the background, our competitors like Lunar Client and Feather/Dawn Client literally **run an instance of Chromium _in-game_** to power their GUIs.\n\n***Yes, clients actually are running Chrome IN YOUR _MINECRAFT_...***\n\nWe use our own rendering library called PolyCompose (based on JetBrains Compose), resulting in drastically better visuals but also performance.\n\nWe package almost **TWICE** as many performance mods as Fabulously Optimized (27 vs 14 mods), meaning performance is significantly better in-game. And don't even get us started with Lunar/Feather...\n\n## User Interface\n\nOneClient features a clean and sleek user interface, meticulously designed by actual designers. Optimized for looking good without sacrificing any easy of use. Supports themeing, so you can choose between what you prefer.\n\n![OneClient UI](https://cdn.modrinth.com/data/cached_images/3b4d80d7a9519e105a87ec875593e0df9d5c31c5_0.webp)\n\n## HUDs\n\nWe package our own HUD mods: EvergreenHUD and VanillaHUD, two of the best HUD mods ever created for Minecraft. On [Hypixel SkyBlock](https://modrinth.com/modpack/oneclient-skyblock), we support all the major SkyBlock mod HUDs, meaning all your favorite mods' HUDs show in one place.\n\n## Fully open-source\n\nThis should go without saying, but we are 100% open-source. We haven't had a single private repository on our GitHub since January 2026.", "body_url": null, "published": "2026-07-22T15:30:21.260778Z", "updated": "2026-09-24T19:53:58.104636Z", "approved": "2026-08-31T21:36:30.512798Z", "queued": "2026-07-26T18:02:57.229142Z", "status": "approved", "requested_status": "approved", "moderator_message": null, "license": {"id": "GPL-3.0-only", "name": "GNU General Public License v3.0 only", "url": null}, "downloads": 201373, "followers": 19, "categories": ["optimization"], "additional_categories": ["lightweight", "multiplayer"], "loaders": ["fabric"], "versions": ["qPNqxyDx", "73IGKiV7", "EODZ9GKP", "9o3pto3u", "lPRzbmIa", "EkWzahsm", "UMHqWO7m", "1G6umbAm", "o5WvNK3o", "aWZjMuvJ", "7VAr5tdT", "ssDC9e7j", "R6Ee6MqG", "KZABaScT", "1Ipdd4FX", "fZR2xlXN", "yGk1mox4", "43hNzWkH", "wmSAIHy4", "Wgt28oDW", "zSgksRq0", "6yJeVzvA", "2kmED1GN", "ssNm7inH", "kTxmOeP9", "ZhyRCj6R", "aQma9aUv", "ObIjRcOz", "SnoPFKda", "FS5KCh4e", "WBTzdrqh", "LCigcI0U", "oUZbcZUH", "ekijW9re", "Gh8Ixt4R", "z8Q84Ciy", "kf4RozaX", "s4XrsWyF", "qKP8sci9", "djTPdCGU", "35G4kDK5", "Q8B2Q5xT", "oot7q1iF", "hB8Zmqi0", "8E5PdwZY", "ZCzJj8wh", "JcBX9bgh", "G0thlru